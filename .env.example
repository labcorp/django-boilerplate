DEBUG=True
PTVSD_SERVER=False
SECRET_KEY='secret'
HASHID_SALT='another_secret'
DATABASE_URL="postgresql://user:pass@db:5432/awesome_app"

# Docker
POSTGRES_USER='user'
POSTGRES_PASSWORD='pass'
POSTGRES_DB='awesome_app'
COMPOSE_PROJECT_NAME='awesome_app'

# Celery (no Docker vem via compose; para rodar local sem Docker use localhost)
# CELERY_BROKER_URL='redis://localhost:6379/0'
# CELERY_RESULT_BACKEND='django-db'
# CELERY_TASK_ALWAYS_EAGER=False

# Storage: s3 | spaces
STORAGE_PROVIDER=None

# S3
# AWS_ACCESS_KEY_ID=ACCESS_ID
# AWS_SECRET_ACCESS_KEY=ACCESS_KEY
# AWS_STORAGE_BUCKET=STORAGE_BUCKET
# AWS_S3_REGION=us-east-1

# Spaces
# SPACES_ENDPOINT=
# SPACES_REGION=
# SPACES_BUCKET=
